[
  {
    "label": "CMake Regenerate",
    "command": "cmake -G \"Ninja Multi-Config\" ..",
    "cwd": "$ZED_WORKTREE_ROOT/build",
    "hide": "on_success",
  },
  {
    "label": "CMake Debug",
    "command": "cmake",
    "cwd": "$ZED_WORKTREE_ROOT/build",
    "hide": "on_success",
    "env": {
      "MAKEFLAGS": "-j16",
    },
    "args": ["--build", ".", "--config", "Debug"],
  },
  {
    "label": "CMake Release",
    "command": "cmake",
    "cwd": "$ZED_WORKTREE_ROOT/build",
    "hide": "on_success",
    "env": {
      "MAKEFLAGS": "-j16",
    },
    "args": ["--build", ".", "--config", "Release"],
  },
  {
    "label": "CMake Clean",
    "command": "cmake --build . --target clean",
    "cwd": "$ZED_WORKTREE_ROOT/build",
    "hide": "on_success",
  },
]
